# Local trên laptop
DEMO_MBB_PORT=8081
ASSISTANT_URL=http://localhost:8090/assistant/
MIA_SCENARIOS_ENABLED=true

# Lỗi mô phỏng khi chọn tính năng Bảo lãnh: Maloi1/50001 hoặc Maloi2/50002.
CONFIG_GUARANTEE_ERROR=Maloi1

# Demo qua Wi-Fi: thay 192.168.1.10 bằng IPv4 LAN của laptop.
# Trình duyệt trên laptop/điện thoại sẽ dùng URL này để tải iframe MIA.
# ASSISTANT_URL=http://192.168.1.10:8090/assistant/

# MIAAssistant/.env phải đồng thời cho phép origin của DemoMSBWeb:
# ALLOWED_HOST_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.10:8081

