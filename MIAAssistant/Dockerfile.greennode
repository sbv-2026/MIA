# syntax=docker/dockerfile:1
FROM node:22-alpine AS web-build
WORKDIR /src
COPY package*.json ./
COPY apps/assistant-web ./apps/assistant-web
COPY packages ./packages
RUN npm install --no-audit --no-fund \
    && npm install --no-save lightningcss-linux-x64-musl@1.33.0 \
    && npm run build

FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ADVISORY_KNOWLEDGE_CONFIG=/app/config/knowledge/advisory-knowledge.yaml MIA_SUPPORT_DB=/app/data/support.sqlite3
WORKDIR /app
COPY services/agent-api ./services/agent-api
RUN pip install --no-cache-dir ./services/agent-api
COPY config ./config
COPY --from=web-build /src/apps/assistant-web/dist ./apps/assistant-web/dist
RUN useradd --create-home --uid 10001 miaassistant && mkdir -p /app/data && chown miaassistant:miaassistant /app/data
USER miaassistant
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"]
WORKDIR /app/services/agent-api
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
