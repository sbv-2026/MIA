# Chon glm hoac gemini; mot flag nay ap dung cho tu van, suy luan va boc tach PO/LC.
MIA_MODEL_PROVIDER=glm
MIA_MODEL_TIMEOUT_SECONDS=45
# Giới hạn riêng cho bóc tách LC; hết thời gian MIA trả kết quả regex/fallback.
MIA_LC_EXTRACTION_TIMEOUT_SECONDS=3

# Backend DemoMSBWeb cung cap danh sach truong cua buoc Thong tin L/C.
MIA_DEMO_HOST_API_URL=http://localhost:8081

# Cau hinh GLM (OpenAI-compatible Chat Completions).
MIA_GLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
MIA_GLM_API_KEY=
MIA_GLM_MODEL=z-ai/glm-5.2-hackathon
MIA_GLM_API_STYLE=chat-completions

# Cau hinh Gemini (Google OpenAI-compatible Chat Completions).
MIA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MIA_GEMINI_API_KEY=
MIA_GEMINI_MODEL=gemini-2.5-flash

# Cau hinh cu/ngoai khac; van duoc dung cho provider openai, external-model,
# va lam fallback cho GLM neu MIA_GLM_* chua duoc thiet lap.
MIA_MODEL_BASE_URL=
MIA_MODEL_API_KEY=
MIA_MODEL_NAME=
MIA_MODEL_API_STYLE=chat-completions

# Các từ/cụm từ bổ sung để nhận diện cảm xúc tiêu cực, phân tách bằng dấu chấm phẩy.
MIA_EMOTION_PHRASES=ngán quá;phát bực;không thể chịu nổi

# VieNeu Cloud realtime TTS. OFF luôn dùng giọng mặc định của trình duyệt.
# Khi ON, consumer web chỉ sử dụng cho Chrome/Safari và tự fallback nếu API lỗi.
MIA_VIENEU_TTS_ENABLED=false
VIENEU_API_KEY=
VIENEU_API_BASE_URL=https://api.vieneu.io/api/v1
VIENEU_TTS_URL=https://api.vieneu.io/api/v1/audio/speech
VIENEU_MODEL=vieneu-v4
VIENEU_VOICE=Quang Định
VIENEU_VOICE_MALE=Quang Định
VIENEU_VOICE_FEMALE=Mai An
MIA_VIENEU_TTS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
MIA_VIENEU_TTS_CONNECT_TIMEOUT_SECONDS=10
MIA_VIENEU_TTS_READ_TIMEOUT_SECONDS=150

# MIA cho phép mọi host gọi API và nhúng iframe, không cần cấu hình origin.

# Support delivery after customer consent (no defaults for recipients).
MIA_SUPPORT_SMTP_HOST=smtp.gmail.com
MIA_SUPPORT_SMTP_PORT=587
MIA_SUPPORT_SMTP_SECURITY=starttls
MIA_SUPPORT_SMTP_USER=vnjp201302@gmail.com
MIA_SUPPORT_EMAIL_FROM=vnjp201302@gmail.com
MIA_SUPPORT_SMTP_PASSWORD=
MIA_SUPPORT_EMAIL_TO=
MIA_SUPPORT_ZALO_WEBHOOK_URL=
MIA_SUPPORT_ZALO_TOKEN=
